# ==========================================================================
# HYDROFLASKER — Configuración de Desarrollo (Desactivar Caché en Hostinger)
# Sube este archivo a tu servidor para forzar actualizaciones instantáneas.
# ==========================================================================

# 1. Desactivar el almacenamiento en caché del navegador para archivos estáticos comunes
<FilesMatch "\.(html|htm|js|css|json)$">
    FileETag None
    <IfModule mod_headers.c>
        Header unset ETag
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "Wed, 11 Jan 1984 05:00:00 GMT"
    </IfModule>
</FilesMatch>

# 2. Desactivar LiteSpeed Cache en Hostinger para desarrollo
<IfModule mod_headers.c>
    Header set X-LiteSpeed-Cache-Control "no-cache"
</IfModule>
